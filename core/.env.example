DATABASE_URL=postgresql+asyncpg://otherworld:otherworld@localhost:5432/otherworld
DATABASE_URL_SYNC=postgresql+psycopg://otherworld:otherworld@localhost:5432/otherworld
# Separate from DATABASE_URL on purpose — the test suite creates/drops the
# full schema on this database every test run. See tests/conftest.py.
TEST_DATABASE_URL=postgresql+asyncpg://otherworld:otherworld@localhost:5432/otherworld_test
REDIS_URL=redis://localhost:6379/0

# LLM provider — Groq (otherworld.llm.providers.groq). Get a key from
# console.groq.com. Without this set, otherworld.llm.factory falls back to
# the deterministic mock provider (fine for tests; not for a real
# Recognition Metric trial — see About/context.md §11).
# See About/spec.md §15.3 for the model choices and rate table.
GROQ_API_KEY=

# No embeddings provider configured yet — Groq has no embeddings endpoint.
# otherworld.llm.providers.mock's deterministic hash is used regardless of
# GROQ_API_KEY above. Separate open item, About/README.md.
EMBEDDING_PROVIDER_API_KEY=
